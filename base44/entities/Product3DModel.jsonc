{
  "name": "Product3DModel",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name for this 3D model"
    },
    "description": {
      "type": "string",
      "description": "Optional description of this 3D model (up to 1000 characters)",
      "maxLength": 1000
    },
    "file_url": {
      "type": "string",
      "description": "URL of the uploaded GLB file"
    },
    "video_url": {
      "type": "string",
      "description": "URL of the 360 spin video recorded from the GLB"
    },
    "page": {
      "type": "string",
      "enum": [
        "busts_and_statues",
        "relief_plaques",
        "photo_imagecast",
        "hall_of_fame",
        "donor_recognition"
      ],
      "description": "Which page this model is featured on"
    },
    "label": {
      "type": "string",
      "description": "Optional label shown on the viewer"
    },
    "sport": {
      "type": "string",
      "enum": [
        "Football",
        "Basketball",
        "Baseball",
        "Hockey",
        "Soccer",
        "Golf",
        "Track & Field",
        "Wrestling",
        "Tennis",
        "Lacrosse",
        "Volleyball",
        "Swimming",
        "Multi-Sport",
        "Hall of Fame"
      ],
      "description": "Sport category for gallery filtering"
    },
    "pose_type": {
      "type": "string",
      "description": "Pose description e.g. 'Passing Stance', 'Heisman Pose'"
    },
    "size_range": {
      "type": "string",
      "description": "Available size range e.g. '24\"-72\"'"
    },
    "price_range": {
      "type": "string",
      "description": "Starting price range e.g. 'From $8,000'"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this model is currently displayed"
    }
  },
  "required": [
    "name",
    "file_url",
    "page"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}