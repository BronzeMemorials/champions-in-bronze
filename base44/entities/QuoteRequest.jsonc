{
  "name": "QuoteRequest",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Full name of the contact"
    },
    "email": {
      "type": "string",
      "description": "Email address"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "organization": {
      "type": "string",
      "description": "Team, university, or organization name"
    },
    "who_for": {
      "type": "string",
      "enum": [
        "Professional Athlete",
        "Sports Team",
        "College / University",
        "Stadium / Arena",
        "Hall of Fame",
        "Donor Program",
        "Athlete Agent",
        "Family"
      ],
      "description": "Who the commission is for"
    },
    "project_type": {
      "type": "string",
      "enum": [
        "Bronze Statue",
        "Portrait Bust",
        "3D Bas-Relief Plaque",
        "Photo Image Cast Plaque",
        "Donor Recognition Wall",
        "Hall of Fame Display",
        "bronze_statue",
        "championship_plaque",
        "hall_of_fame",
        "donor_wall",
        "dimensional_letters",
        "jersey_display",
        "capital_campaign",
        "custom_jersey_plaque",
        "relief_plaque",
        "paperweight",
        "other"
      ],
      "description": "Type of project"
    },
    "display_location": {
      "type": "string",
      "enum": [
        "Stadium / Arena",
        "Hall of Fame",
        "Athletic Facility",
        "Training Facility",
        "Office / Private",
        "University Campus",
        "Home"
      ],
      "description": "Where the piece will be displayed"
    },
    "preferred_size": {
      "type": "string",
      "description": "Preferred size of the commission"
    },
    "budget_range": {
      "type": "string",
      "enum": [
        "Under $2,500",
        "$2,500\u2013$7,500",
        "$7,500\u2013$25,000",
        "$25,000\u2013$75,000",
        "$75,000+",
        "under_5k",
        "5k_15k",
        "15k_50k",
        "50k_100k",
        "100k_250k",
        "over_250k"
      ],
      "description": "Approximate budget range"
    },
    "timeline": {
      "type": "string",
      "description": "Desired completion timeline"
    },
    "description": {
      "type": "string",
      "description": "Project details and requirements"
    },
    "file_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Uploaded reference files (logos, photos, briefs)"
    },
    "source_domain": {
      "type": "string",
      "enum": [
        "pro",
        "edu",
        "shop"
      ],
      "description": "Which site the request came from"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "proposal_sent",
        "in_progress",
        "completed",
        "closed"
      ],
      "default": "new",
      "description": "Quote request status"
    }
  },
  "required": [
    "name",
    "email"
  ]
}