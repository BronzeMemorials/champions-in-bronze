{
  "name": "ABTestVariant",
  "type": "object",
  "properties": {
    "test_id": {
      "type": "string",
      "description": "Identifier for the test (e.g. 'quote_form_title')"
    },
    "phrase": {
      "type": "string",
      "description": "The exact phrase/variant being tested"
    },
    "description": {
      "type": "string",
      "description": "Optional description of what this variant tests and why (up to 1000 characters)",
      "maxLength": 1000
    },
    "impressions": {
      "type": "number",
      "default": 0,
      "description": "Number of times this variant was shown"
    },
    "conversions": {
      "type": "number",
      "default": 0,
      "description": "Number of quote form submissions with this variant"
    },
    "clicks": {
      "type": "number",
      "default": 0,
      "description": "Number of times user clicked/interacted with the form under this variant"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this variant is still being tested (false = retired/filtered out)"
    }
  },
  "required": [
    "test_id",
    "phrase"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}